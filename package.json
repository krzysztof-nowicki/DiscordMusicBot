{
  "name": "discord-music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Discord music bot: YouTube, Spotify, SoundCloud, radio, any yt-dlp site and local files",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:live": "node --test \"test/live/*.test.js\""
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "music-metadata": "11.16.1",
    "prism-media": "1.3.5"
  },
  "optionalDependencies": {
    "@discordjs/opus": "0.10.0",
    "opusscript": "0.0.8"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  }
}
