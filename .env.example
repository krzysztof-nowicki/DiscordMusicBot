# Required: bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Optional: your server id for instant slash-command registration (otherwise global, up to ~1h)
GUILD_ID=
# Local music folder (default: %USERPROFILE%\Music)
MUSIC_DIR=
# Optional Spotify app credentials (https://developer.spotify.com/dashboard) - without them public embed pages are used
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional role allowed to skip others' tracks / stop / clear / change volume
DJ_ROLE=
# Bot messages: pl | en
LANG_BOT=pl
DEFAULT_VOLUME=60
IDLE_LEAVE_MIN=5
ALONE_LEAVE_MIN=3
# Optional overrides
FFMPEG_PATH=
YTDLP_PATH=
# Optional cookies.txt (Netscape format) for age-restricted YouTube videos
YTDLP_COOKIES=

# --- Cloud / Northflank ---
# Base64 of a YouTube cookies.txt (see DEPLOY_NORTHFLANK.md step 6) — helps against "confirm you're not a bot"
YTDLP_COOKIES_B64=
# When YouTube blocks the server: soundcloud | none
YT_FALLBACK=soundcloud
# opus (low CPU, default on Linux) | pcm (default on Windows)
AUDIO_MODE=
# Optional: serve GET /health on this port (not needed on Northflank)
PORT=
DATA_DIR=
BIN_DIR=

# --- Resource limits (defaults shown) ---
PAUSE_LEAVE_MIN=10
PAUSE_KILL_SEC=60
# 3 on Linux, 10 on Windows when empty
MAX_ACTIVE_PLAYERS=
NP_UPDATE_SEC=30
PREFETCH_LEAD_SEC=20
MAX_PLAYLIST=200
MAX_QUEUE=500
PLAY_RATE_COUNT=5
PLAY_RATE_WINDOW_SEC=10
YTDLP_CONCURRENCY=
